{
  "version": "1.0",
  "thema": "Mehr Energie nach schlechtem Schlaf",
  "typen": {
    "massnahme": "Konkrete Handlung, die der Nutzer ausführen kann.",
    "massgabe": "Richtwert oder Rahmen, an dem sich Empfehlungen orientieren (Zeitpunkt, Menge, Reihenfolge).",
    "restriktion": "Harte Grenze oder Verbot. Hat immer Vorrang vor Maßnahmen und Maßgaben."
  },
  "kontext_variablen": {
    "min_seit_aufwachen": "Zahl – Minuten seit dem Aufwachen",
    "std_seit_aufwachen": "Zahl – Stunden seit dem Aufwachen",
    "std_bis_schlafenszeit": "Zahl – Stunden bis zur geplanten Schlafenszeit",
    "uhrzeit": "HH:MM – aktuelle Uhrzeit",
    "spaet_aufgewacht": "bool – deutlich später als geplant aufgewacht",
    "trinkt_regelmaessig_kaffee": "bool",
    "koffeinempfindlich": "bool",
    "koffein_heute_mg": "Zahl – bisher heute aufgenommenes Koffein",
    "std_seit_letztem_koffein": "Zahl",
    "energietief": "bool – akutes Energietief",
    "schlaefrig": "bool – echte Schläfrigkeit (nicht nur Unlust)",
    "extrem_erschoepft": "bool",
    "sekundenschlaf": "bool – Sekundenschlaf / Wegnicken",
    "massiver_schlafmangel": "bool",
    "fit_fuer_sport": "bool – fühlt sich fit genug für lockeres Training",
    "hunger": "bool",
    "nach_mittagessen": "bool – innerhalb ca. 1 Stunde nach dem Mittagessen",
    "nach_nap": "bool – gerade aus einem Nap aufgewacht",
    "sitzdauer_min": "Zahl – Minuten seit der letzten Bewegungspause",
    "freie_zeit_min": "Zahl – verfügbare Zeit am Stück",
    "muss_danach_leistungsfaehig": "bool – direkt danach steht etwas Wichtiges an"
  },
  "bloecke": [
    {
      "id": "AUF_WASSER",
      "typ": "massnahme",
      "kategorie": "aufwachen",
      "titel": "Wasser trinken",
      "text": "Trinke direkt nach dem Aufwachen 500 ml Wasser.",
      "bedingung": "min_seit_aufwachen <= 30",
      "parameter": { "menge_ml": 500 },
      "prioritaet": 1
    },
    {
      "id": "AUF_TAGESLICHT",
      "typ": "massnahme",
      "kategorie": "aufwachen",
      "titel": "Tageslicht tanken",
      "text": "Geh innerhalb der ersten 30 Minuten für 10–20 Minuten nach draußen ins Tageslicht.",
      "bedingung": "min_seit_aufwachen <= 30",
      "parameter": { "dauer_min": [10, 20], "spaetestens_nach_min": 30 },
      "prioritaet": 1
    },
    {
      "id": "AUF_SPAZIEREN",
      "typ": "massnahme",
      "kategorie": "aufwachen",
      "titel": "Zügig spazieren statt hinlegen",
      "text": "Geh 5–10 Minuten zügig spazieren, statt dich direkt wieder hinzulegen.",
      "bedingung": "min_seit_aufwachen <= 60",
      "parameter": { "dauer_min": [5, 10] },
      "prioritaet": 2
    },
    {
      "id": "AUF_FRUEHSTUECK_OPTIONAL",
      "typ": "massgabe",
      "kategorie": "aufwachen",
      "titel": "Frühstück nicht erzwingen",
      "text": "Wenn du keinen Hunger hast, musst du nicht frühstücken.",
      "bedingung": "!hunger && min_seit_aufwachen <= 90",
      "parameter": {},
      "prioritaet": 3
    },

    {
      "id": "SPAET_KEIN_NACHHOLEN",
