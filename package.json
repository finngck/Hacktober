{
  "name": "pivot-prototype",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.14"
  },
  "scripts": {
    "dev": "node --import tsx --watch-path=server --watch-path=shared --watch-preserve-output server/index.ts",
    "build": "npm run typecheck && vite build",
    "start": "node --import tsx server/index.ts --production",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:live": "node --import tsx scripts/check-gemma.ts",
    "format": "prettier --write src server api shared tests scripts public index.html package.json tsconfig.json vite.config.ts vercel.json",
    "format:check": "prettier --check src server api shared tests scripts public index.html package.json tsconfig.json vite.config.ts vercel.json",
    "voice:setup": "node --import tsx scripts/configure-voice.ts",
    "test:voice:live": "node --import tsx scripts/check-voice.ts"
  },
  "dependencies": {
    "@base-ui/react": "^1.9.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@hugeicons/core-free-icons": "^3.0.0",
    "@hugeicons/react": "^1.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "express": "^5.3.0",
    "lucide-react": "^1.61.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tailwind-merge": "^3.7.0",
    "zod": "^4.6.7",
    "@elevenlabs/elevenlabs-js": "^2.74.0",
    "@elevenlabs/react": "^1.19.1"
  },
  "devDependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "@types/express": "^5.0.0",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "prettier": "^3.9.10",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.20.0",
    "typescript": "~6.0.3",
    "vite": "^8.3.4"
  }
}
