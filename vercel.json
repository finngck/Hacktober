{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "buildCommand": "npm run build",
  "outputDirectory": "dist",
  "functions": {
    "api/replan.ts": {
      "maxDuration": 70
    },
    "api/extract.ts": {
      "maxDuration": 60
    },
    "api/voice/[...path].ts": {
      "maxDuration": 70
    },
    "api/voice/v1/chat/completions.ts": {
      "maxDuration": 70
    }
  },
  "rewrites": [
    {
      "source": "/app",
      "destination": "/app.html"
    },
    {
      "source": "/app/(.*)",
      "destination": "/app.html"
    }
  ]
}
