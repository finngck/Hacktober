# Server only. Never use VITE_ for credentials.
GEMMA_API_KEY=
GEMMA_MODEL=gemma-4-26b-a4b-it
PORT=3000
# Server-only voice integration. The onboarding stores ELEVENLABS_API_KEY in .env.local.
ELEVENLABS_API_KEY=
ELEVENLABS_AGENT_ID=
VOICE_LLM_SECRET=
# Optional voice ID; defaults to Sarah.
# ELEVENLABS_VOICE_ID=
# Optional additional deployed hostnames, comma-separated (without https://).
# APP_HOSTS=
# Alternatively, point to an existing local key file without copying it:
# GEMMA_KEY_FILE=/absolute/path/to/GEMMA.env
